      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "efc4u1hk02pz4d"
          },
          "query": "models = ${model:json}\n\nprompt = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openwebui_stats\")\n  |> filter(fn: (r) => r._field == \"promptEvalCount\")\n  |> filter(fn: (r) => \"${model}\" == \"$__all\" or contains(value: r.model, set: models))\n  |> group(columns: [\"model\"])\n  |> sum()\n\neval = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openwebui_stats\")\n  |> filter(fn: (r) => r._field == \"evalCount\")\n  |> filter(fn: (r) => \"${model}\" == \"$__all\" or contains(value: r.model, set: models))\n  |> group(columns: [\"model\"])\n  |> sum()\n\nunion(tables: [prompt, eval])\n  |> group(columns: [\"model\"])\n  |> sum()\n  |> filter(fn: (r) => r._value > 0)\n  |> rename(columns: {_value: \"\"})",
          "refId": "A"
        }
      ],
      "title": "Token Usage by Model (Total Tokens)",
      "type": "bargauge"
